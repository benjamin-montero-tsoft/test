<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log4j:configuration SYSTEM  "log4j.dtd" >
<log4j:configuration>
	<appender name="rolling-file" class="org.apache.log4j.RollingFileAppender">
				<!-- produccion -->
             	 <param name="file" value="/filerecept/RCFiles/logs/bajadaMensual.log"/> 
             	<!-- LOCAL -->
             	<!-- param name="file" value="C:/bajadaAMDOCSMensual/log/ReporteCrediticio.log"/> -->
             	<!-- DESARROLLO - serve212 -->
             	<!--  <param name="file" value="/home/usuarios/sfg/sfg126/home/ctmprod/scp/applcred/bajadaAmdocsMensual/logs/bajadaMensual.log"/>-->
