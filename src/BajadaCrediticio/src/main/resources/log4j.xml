             	<!--<param name="file" value="/home/usuarios/sfi/sfi525/Test/crediticioBatch/bajadaAMDOCSMensual/log/ReporteCrediticio.log"/>-->
	        	<param name="MaxFileSize" value="2MB"/>
	         	<param name="MaxBackupIndex" value="3"/>
				<layout class="org.apache.log4j.PatternLayout">
